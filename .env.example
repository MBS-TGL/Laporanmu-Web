VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>
# GROQ_API_KEY sekarang disimpan sebagai secret Edge Function `ai-proxy`:
#   supabase secrets set GROQ_API_KEY=gsk_...
# Opsional untuk guardrail `ai-proxy`:
#   supabase secrets set APP_ORIGIN=https://app.laporanmu.id,http://localhost:5174
#   supabase secrets set AI_MINUTE_LIMIT=5 AI_DAY_LIMIT=30 AI_MINUTE_TOKENS=24000 AI_DAY_TOKENS=180000
